# Copy to .env and fill private values, or use scripts/start.ps1 for local secret generation.
APP_ENV=local
AUTH_SECRET=
DATABASE_URL=postgresql+psycopg://metro:CHANGE_ME@127.0.0.1:5433/metro
MIGRATION_DATABASE_URL=postgresql+psycopg://metro_owner:CHANGE_ME@127.0.0.1:5433/metro
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATION_PASSWORD=
SIMULATION_ENABLED=false
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
NETWORK_FILE=data/operator-network.json
HARDWARE_ENABLED=false
SERVICE_REPORT_MAX_AGE_SECONDS=30
SERVICE_CONSENSUS_WINDOW_SECONDS=120
SERVICE_CONSENSUS_USERS=3
REROUTE_DELAY_SECONDS=180
REROUTE_MIN_SAVING_SECONDS=120
# Optional reviewed station fingerprints; leave empty until real field mapping exists.
CELL_MAP_FILE=
# CONTAINER_NETWORK_FILE=/app/provider/network.json
MQTT_ENABLED=false
MQTT_PORT=8883
MQTT_CA_FILE=
MQTT_PASSWORD=
# Required for the production Compose overlay behind HTTPS:
# PUBLIC_ORIGIN=https://your-application.example
# PUBLIC_HOST=your-application.example
